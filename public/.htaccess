# Martis Docs — Apache/LiteSpeed config for shared hosting (getmartis.com).

<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|webp|avif|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Video loops: no validators. The CDN answers a range request with If-Range
# with the whole file (200) instead of the range (206), so Safari, which
# sends If-Range when it revalidates a cached video on reload, failed to play
# the loops after a refresh. Without ETag / Last-Modified it never sends one.
<FilesMatch "\.(mp4|webm)$">
  FileETag None
  <IfModule mod_headers.c>
    Header unset ETag
    Header unset Last-Modified
    Header set Cache-Control "public, max-age=31536000"
  </IfModule>
</FilesMatch>

