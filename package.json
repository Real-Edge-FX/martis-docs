{
  "name": "martis-docs",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Documentation site for the Martis admin engine — getmartis.com",
  "scripts": {
    "dev": "node scripts/build-search-index.mjs && vite",
    "build:client": "vite build",
    "build:ssr": "vite build --config vite.ssr.config.ts",
    "prerender": "node scripts/prerender.mjs",
    "build": "pnpm build-search && pnpm build:client && pnpm build:ssr && pnpm prerender",
    "preview": "vite preview --port 4173",
    "sync-docs": "node scripts/sync-docs.mjs",
    "build-search": "node scripts/build-search-index.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:prerender": "node scripts/prerender-unit.test.mjs && node scripts/smoke-dist-unit.test.mjs && node scripts/sync-docs-unit.test.mjs && node scripts/deploy-script.test.mjs && node scripts/build-search-index.test.mjs && node scripts/prerender.test.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.1",
    "motion": "^12.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mdx-js/mdx": "^3.1.1",
    "@tailwindcss/typography": "^0.5.18",
    "@tailwindcss/vite": "^4.1.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwindcss": "^4.1.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.4.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  }
}
